)
## common plotting function
make_facil_panel <- function(data, month_select, y_var, se_var, y_lab,
show_legend = FALSE,
use_linetype = FALSE,
reverse_linetype = FALSE) {
plot_df <- data %>%
dplyr::filter(
Month == month_select,
!is.na(mfacil_received_prop),
!is.na(.data[[y_var]])
)
label_df <- plot_df %>%
dplyr::filter(Species %in% focal_species_selected)
p <- ggplot(
plot_df,
aes(
x = mfacil_received_prop,
y = .data[[y_var]],
color = N_label
)
) +
geom_point(
position = position_dodge(width = 0.02),
size = 2,
alpha = 0.9
) +
geom_errorbar(
aes(
ymin = .data[[y_var]] - .data[[se_var]],
ymax = .data[[y_var]] + .data[[se_var]]
),
position = position_dodge(width = 0.02),
width = 0.02,
alpha = 0.6,
linewidth = 0.5,
na.rm = TRUE
) +
geom_text_repel(
data = label_df,
aes(label = Species),
size = 2.8,
box.padding = 0.2,
point.padding = 0.3,
segment.alpha = 0.3,
force = 2,
max.iter = 5000,
min.segment.length = 0,
color = "black"
) +
labs(
x = "Proportion of facilitation",
y = y_lab,
color = "Treatment",
fill = "Treatment",
linetype = "Treatment"
) +
scale_color_manual(
values = c(
"Without nitrogen" = "#99CCFF",
"With nitrogen" = "#336699"
)
) +
scale_fill_manual(
values = c(
"Without nitrogen" = "#99CCFF",
"With nitrogen" = "#336699"
)
) +
theme_minimal() +
theme(
strip.text = element_text(size = 11, face = "plain"),
strip.background = element_blank(),
axis.title = element_text(size = 11, face = "plain"),
axis.text = element_text(size = 11, face = "plain"),
panel.grid = element_blank(),
legend.position = ifelse(show_legend, "right", "none"),
legend.background = element_rect(fill = "white", color = NA),
legend.key = element_rect(fill = "white", color = NA),
panel.border = element_rect(color = "black", fill = NA, linewidth = 0.5),
axis.line = element_line(color = "black", linewidth = 0.5),
axis.ticks = element_line(color = "black", linewidth = 0.5),
panel.background = element_rect(fill = "white", color = NA),
plot.background = element_rect(fill = "white", color = NA)
)
if (use_linetype) {
line_values <- if (reverse_linetype) {
c(
"Without nitrogen" = "solid",
"With nitrogen" = "dashed"
)
} else {
c(
"Without nitrogen" = "dashed",
"With nitrogen" = "solid"
)
}
p <- p +
geom_smooth(
aes(fill = N_label, linetype = N_label),
method = "lm",
se = TRUE,
linewidth = 1,
alpha = 0.1
) +
scale_linetype_manual(values = line_values)
} else {
p <- p +
geom_smooth(
aes(fill = N_label),
method = "lm",
linetype = "solid",
se = TRUE,
linewidth = 1,
alpha = 0.1
)
}
return(p)
}
